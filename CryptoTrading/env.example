# ===============================
# Application Configuration
# ===============================

# Full JDBC connection string for the MySQL database.
# Example: jdbc:mysql://localhost:3306/trading
DB_URL=jdbc:mysql://localhost:3306/trading

# Username for connecting to the database
DB_USERNAME=your_db_username

# Password for connecting to the database
DB_PASSWORD=your_db_password


# ===============================
# Payment Gateway - Razorpay
# ===============================

# Your Razorpay API Secret Key
# Get this from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_API_SECRET=your_razorpay_secret

# Your Razorpay API Key ID
# Get this from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_API_KEY=your_razorpay_key


#

# ===============================
# Payment Gateway - Stripe
# ===============================
STRIPE_API_KEY=your_stripe_secret_key


# ===============================
# Public URL of the backend
# ===============================
# Razorpay / Stripe redirect the user to <APP_BASE_URL>/api/wallet/deposit after paying
APP_BASE_URL=http://localhost:8080


# ===============================
# Email (OTP mails)
# ===============================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
# For Gmail, create an App Password (Google Account -> Security -> App passwords)
MAIL_PASSWORD=your_app_password
